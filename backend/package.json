{
  "name": "visionboard-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:api": "esbuild dev/server.ts --bundle --platform=node --format=esm --target=node22 --external:@aws-sdk/* --outfile=.dev/server.mjs --log-level=warning && node .dev/server.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1163.0",
    "@aws-sdk/lib-dynamodb": "^3.1163.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
